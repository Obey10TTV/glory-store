NODE_ENV=development
PORT=5000
# Local development binds to 127.0.0.1. Railway production binds to 0.0.0.0 automatically.
# HOST=0.0.0.0
MONGO_URI=
MONGO_DB_NAME=glory-store
DEFAULT_MARKET_CODE=NG
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_ISSUER=glory-store-api
JWT_AUDIENCE=glory-web
OTP_SECRET=
RATE_LIMIT_KEY_SECRET=
LOG_HASH_SECRET=
SESSION_IP_SALT=
SESSION_IDLE_HOURS=24
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=

# Nigeria service billing. Buyer-to-seller product payments are never collected by Glory.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# UK, US and Canada service billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Seller activation is disabled by default. Revenue comes from plans and paid visibility.
SELLER_ACTIVATION_REQUIRED=false
SELLER_ACTIVATION_FEE_PENCE=0
NG_SELLER_ACTIVATION_REQUIRED=false
US_SELLER_ACTIVATION_REQUIRED=false
CA_SELLER_ACTIVATION_REQUIRED=false

# Monthly plan prices in each currency's minor unit (pence/cents/kobo).
NG_SELLER_STUDIO_MONTHLY_FEE_MINOR=750000
NG_SELLER_SCALE_MONTHLY_FEE_MINOR=2200000
NG_SELLER_PARTNER_MONTHLY_FEE_MINOR=6000000
SELLER_STUDIO_MONTHLY_FEE_PENCE=5900
SELLER_SCALE_MONTHLY_FEE_PENCE=14900
SELLER_PARTNER_MONTHLY_FEE_PENCE=39900
US_SELLER_STUDIO_MONTHLY_FEE_MINOR=6900
US_SELLER_SCALE_MONTHLY_FEE_MINOR=17900
US_SELLER_PARTNER_MONTHLY_FEE_MINOR=44900
CA_SELLER_STUDIO_MONTHLY_FEE_MINOR=8900
CA_SELLER_SCALE_MONTHLY_FEE_MINOR=22900
CA_SELLER_PARTNER_MONTHLY_FEE_MINOR=56900

# Optional Stripe recurring Price IDs. Inline server-owned prices are used when omitted.
STRIPE_SELLER_STUDIO_PRICE_ID=
STRIPE_SELLER_SCALE_PRICE_ID=
STRIPE_SELLER_PARTNER_PRICE_ID=
STRIPE_US_SELLER_STUDIO_PRICE_ID=
STRIPE_US_SELLER_SCALE_PRICE_ID=
STRIPE_US_SELLER_PARTNER_PRICE_ID=
STRIPE_CA_SELLER_STUDIO_PRICE_ID=
STRIPE_CA_SELLER_SCALE_PRICE_ID=
STRIPE_CA_SELLER_PARTNER_PRICE_ID=

# Market-specific listing and reviewed-video advertising prices.
NG_HOMEPAGE_SPOTLIGHT_7_FEE_MINOR=500000
NG_HOMEPAGE_SPOTLIGHT_30_FEE_MINOR=1500000
NG_HOMEPAGE_VIDEO_7_FEE_MINOR=2500000
NG_HOMEPAGE_VIDEO_30_FEE_MINOR=7500000
HOMEPAGE_SPOTLIGHT_7_FEE_PENCE=8900
HOMEPAGE_SPOTLIGHT_30_FEE_PENCE=24900
GB_HOMEPAGE_VIDEO_7_FEE_MINOR=19900
GB_HOMEPAGE_VIDEO_30_FEE_MINOR=54900
US_HOMEPAGE_SPOTLIGHT_7_FEE_MINOR=9900
US_HOMEPAGE_SPOTLIGHT_30_FEE_MINOR=27900
US_HOMEPAGE_VIDEO_7_FEE_MINOR=24900
US_HOMEPAGE_VIDEO_30_FEE_MINOR=69900
CA_HOMEPAGE_SPOTLIGHT_7_FEE_MINOR=12900
CA_HOMEPAGE_SPOTLIGHT_30_FEE_MINOR=34900
CA_HOMEPAGE_VIDEO_7_FEE_MINOR=31900
CA_HOMEPAGE_VIDEO_30_FEE_MINOR=84900
NG_SPOTLIGHT_CAPACITY=8
NG_VIDEO_CAPACITY=4
GB_SPOTLIGHT_CAPACITY=8
GB_VIDEO_CAPACITY=4
US_SPOTLIGHT_CAPACITY=8
US_VIDEO_CAPACITY=4
CA_SPOTLIGHT_CAPACITY=8
CA_VIDEO_CAPACITY=4

# Keep buyer-to-seller checkout disabled for Glory's classified-marketplace model.
GLORY_DIRECT_CHECKOUT=false
PLATFORM_COMMISSION_BPS=0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_SAFETY_EMAIL=
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=
SUI_VERIFICATION_REGISTRY_ID=
SUI_VERIFICATION_EVENT_TYPE=
SUI_EXPLORER_BASE_URL=https://suiscan.xyz/testnet
