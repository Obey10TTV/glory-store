NODE_ENV=development
PORT=5000
MONGO_URI=
MONGO_DB_NAME=glory-store
JWT_SECRET=
JWT_EXPIRES_IN=2h
OTP_SECRET=
GOOGLE_CLIENT_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
SELLER_ACTIVATION_REQUIRED=false
SELLER_ACTIVATION_FEE_PENCE=4900
SELLER_STUDIO_MONTHLY_FEE_PENCE=5900
SELLER_SCALE_MONTHLY_FEE_PENCE=14900
SELLER_PARTNER_MONTHLY_FEE_PENCE=39900
# Optional Stripe recurring Price IDs. When omitted, Checkout uses server-owned inline price data.
STRIPE_SELLER_STUDIO_PRICE_ID=
STRIPE_SELLER_SCALE_PRICE_ID=
STRIPE_SELLER_PARTNER_PRICE_ID=
HOMEPAGE_SPOTLIGHT_7_FEE_PENCE=8900
HOMEPAGE_SPOTLIGHT_30_FEE_PENCE=24900
HOMEPAGE_SPOTLIGHT_CAPACITY=8
# Keep buyer-to-seller checkout disabled for Glory's classified-marketplace model.
GLORY_DIRECT_CHECKOUT=false
PLATFORM_COMMISSION_BPS=1000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
