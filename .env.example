SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_SAFETY_EMAIL=
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
